{
  "name": "axiom-learning-runtime",
  "version": "0.1.0",
  "description": "Configuration-driven scientific learning PWA",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:demo": "npm run typecheck && npm run lint && npm run test:e2e",
    "budget": "tsx scripts/budget/check-bundle.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "schema:export": "tsx scripts/export-json-schema.ts",
    "assets:hash": "tsx scripts/assets/hash-assets.ts",
    "model:prepare": "node scripts/models/prepare-model.mjs",
    "media:fixtures": "node scripts/media/generate-fixtures.mjs",
    "dicom:deidentify": "python scripts/dicom/deidentify-series.py",
    "dicom:prepare": "node scripts/dicom/prepare-series.mjs",
    "dicom:audit": "node scripts/dicom/audit-phi.mjs",
    "dicom:preview": "python scripts/dicom/preview-series.py",
    "dicom:verify": "node scripts/dicom/verify-series.mjs",
    "dicom:serve": "node scripts/dicom/serve-series.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content && npm run build && npm run budget"
  },
  "keywords": [
    "learning",
    "medical",
    "pwa"
  ],
