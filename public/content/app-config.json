  "challenges": [
    {
      "id": "daily-imaging-interpretation",
      "type": "daily",
      "title": "Imaging Interpretation",
      "description": "Five rapid checks across imaging concepts.",
      "estimatedMinutes": 3,
      "rewardXp": 50,
      "itemCount": 5,
      "items": [
        {
          "id": "daily-q1",
          "type": "multiple_choice",
          "conceptIds": ["image-windowing"],
          "content": {
            "prompt": "Which window best emphasizes lung parenchyma?",
            "options": [
              { "id": "lung", "label": "Lung window" },
              { "id": "bone", "label": "Bone window" },
              { "id": "brain", "label": "Brain window" }
            ],
            "correctOptionId": "lung",
            "explanation": "A lung window spans the low attenuation range needed to inspect aerated lung."
          },
          "assets": [],
          "completion": { "mode": "answer" },
          "scoring": { "xp": 10, "difficulty": "foundation" },
          "feedback": { "retry": false }
        },
        {
          "id": "daily-q2",
          "type": "multiple_choice",
          "conceptIds": ["clinical-trial-design"],
          "content": {
            "prompt": "What is the main purpose of randomization?",
            "options": [
              { "id": "balance", "label": "Balance known and unknown confounders" },
              { "id": "speed", "label": "Shorten every trial" },
              { "id": "blinding", "label": "Guarantee participant blinding" }
            ],
            "correctOptionId": "balance",
            "explanation": "Random allocation reduces systematic baseline differences between groups."
          },
          "assets": [],
          "completion": { "mode": "answer" },
          "scoring": { "xp": 10, "difficulty": "foundation" },
          "feedback": { "retry": false }
        },
        {
          "id": "daily-q3",
          "type": "multiple_choice",
          "conceptIds": ["biostatistics"],
          "content": {
            "prompt": "A wider confidence interval generally indicates what?",
            "options": [
              { "id": "less-precision", "label": "Less precision" },
              { "id": "more-precision", "label": "More precision" },
              { "id": "no-bias", "label": "No risk of bias" }
            ],
            "correctOptionId": "less-precision",
            "explanation": "Width reflects uncertainty around the estimated effect."
          },
          "assets": [],
          "completion": { "mode": "answer" },
          "scoring": { "xp": 10, "difficulty": "intermediate" },
          "feedback": { "retry": false }
        },
        {
          "id": "daily-q4",
          "type": "multiple_choice",
          "conceptIds": ["safety-signals"],
          "content": {
            "prompt": "What should an unexpected clustered event prompt first?",
            "options": [
              { "id": "assess", "label": "Structured signal assessment" },
              { "id": "ignore", "label": "No action until proof is absolute" },
              { "id": "publish", "label": "Immediate public attribution" }
            ],
            "correctOptionId": "assess",
            "explanation": "A structured assessment establishes strength, alternatives and urgency."
          },
          "assets": [],
          "completion": { "mode": "answer" },
          "scoring": { "xp": 10, "difficulty": "intermediate" },
          "feedback": { "retry": false }
        },
        {
          "id": "daily-q5",
          "type": "multiple_choice",
          "conceptIds": ["dose-response"],
          "content": {
            "prompt": "A plateau in response most directly suggests what?",
            "options": [
              { "id": "maximal", "label": "A maximal effect may have been reached" },
              { "id": "zero", "label": "The compound has no activity" },
              { "id": "bias", "label": "Randomization failed" }
            ],
            "correctOptionId": "maximal",
            "explanation": "A plateau can represent saturation of the achievable biological effect."
          },
          "assets": [],
          "completion": { "mode": "answer" },
          "scoring": { "xp": 10, "difficulty": "intermediate" },
          "feedback": { "retry": false }
        }
      ]
    },
