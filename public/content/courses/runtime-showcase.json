          "type": "rich_text",
          "conceptIds": ["biostatistics"],
          "content": {
            "heading": "Read evidence before interpreting it",
            "body": "A confidence interval describes uncertainty around an estimate. Compare its width with the effect size before drawing a conclusion.",
            "emphasis": ["effect size"],
            "terms": [
              {
                "term": "confidence interval",
                "definition": "A range of values compatible with the observed estimate under the analysis assumptions."
              }
            ],
            "bullets": ["Separate magnitude from precision.", "State uncertainty explicitly."],
            "keyTakeaway": "Strong interpretation combines an estimate with its uncertainty."
          },
          "assets": [],
          "completion": { "mode": "viewed" },
          "scoring": {},
          "feedback": {}
        },
