        {
          "id": "showcase-scenario",
          "type": "scenario",
          "conceptIds": ["biostatistics"],
          "content": {
            "startNodeId": "scenario-context",
            "nodes": [
              {
                "id": "scenario-context",
                "type": "context",
                "body": "A small experiment reports a large effect with a wide confidence interval.",
                "asset": {
                  "assetId": "showcase-cell-map",
                  "alt": "Synthetic observation field used as scenario context."
                },
                "next": "interpret-estimate"
              },
              {
                "id": "interpret-estimate",
                "type": "decision",
                "prompt": "What is the most defensible first interpretation?",
                "choices": [
                  {
                    "id": "promising-uncertain",
                    "label": "The effect is promising but uncertain",
                    "consequence": "This separates observed magnitude from limited precision.",
                    "next": "plan-followup",
                    "score": 1,
                    "quality": "Best: acknowledges both signal and uncertainty."
                  },
                  {
                    "id": "proven-effect",
                    "label": "The effect is already proven",
                    "consequence": "The wide interval does not support that level of certainty.",
                    "next": "plan-followup",
                    "score": 0,
                    "quality": "Overstated: precision remains limited."
                  }
                ]
              },
              {
                "id": "plan-followup",
                "type": "decision",
                "prompt": "What should the next study prioritize?",
                "choices": [
                  {
                    "id": "more-precision",
                    "label": "Increase precision with an adequately sized replication",
                    "consequence": "Replication can test the signal and narrow uncertainty.",
                    "next": "scenario-outcome",
                    "score": 1,
                    "quality": "Best: directly addresses uncertainty."
                  },
                  {
                    "id": "change-colors",
                    "label": "Change the chart colors",
                    "consequence": "Display styling does not resolve statistical uncertainty.",
                    "next": "scenario-outcome",
                    "score": 0,
                    "quality": "Weak: presentation does not improve evidence."
                  }
                ]
              },
              {
                "id": "scenario-outcome",
                "type": "outcome",
                "title": "A calibrated conclusion",
                "body": "The team reports the early signal with its uncertainty and plans a stronger replication.",
                "result": "Good interpretation matches confidence to the available evidence."
              }
            ]
          },
          "assets": ["showcase-cell-map"],
          "completion": { "mode": "outcome" },
          "scoring": { "weight": 1 },
          "feedback": {}
        },
