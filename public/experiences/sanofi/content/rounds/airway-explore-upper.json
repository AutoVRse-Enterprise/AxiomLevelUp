{
  "schemaVersion": "0.1",
  "roundVersion": "1",
  "id": "airway-explore-upper",
  "title": "Find your way: upper airway",
  "mechanic": "spatial_explore",
  "anatomyMapId": "respiratory-game-map",
  "intro": "Start at the orange drop point. Move back toward the central airway, compare nearby branches, then identify the original lobe and segment.",
  "timeLimitSeconds": 80,
  "drop": {
    "pools": {
      "warmup": ["right-upper-apical-airway", "right-upper-anterior-airway", "left-upper-apicoposterior-airway", "left-upper-anterior-airway"],
      "challenge": ["right-upper-apical-airway", "right-upper-anterior-airway", "left-upper-apicoposterior-airway", "left-upper-anterior-airway"],
      "expert": ["right-upper-apical-airway", "left-upper-apicoposterior-airway"]
    }
  },
  "explore": {
    "id": "upper-airway-scene",
    "type": "anatomy_explore",
    "content": {
      "anatomyMapId": "respiratory-game-map",
      "prompt": "The orange beacon stays at your drop point. Use Back and branch buttons to trace its path on the visible airway map.",
      "startView": { "mode": "waypoint_marker", "waypointId": "right-upper-apical-airway" },
      "navigation": "both",
      "orientationLabels": "patient",
      "movement": { "maxMoves": 5, "maxHopsFromEntry": 2, "freeBacktrack": true }
    },
    "completion": { "mode": "minimum_interactions", "count": 1 }
  },
  "primitive": {
    "id": "upper-airway-pin",
    "type": "anatomy_locate",
    "content": {
      "anatomyMapId": "respiratory-game-map",
      "prompt": "Choose the drop point's lobe, then its segment.",
      "answerFrom": "entry",
      "navigation": "orbit",
      "levels": [
        {
          "levelId": "lobe",
          "input": "choice",
          "weight": 0.55,
          "options": [
            { "id": "right-upper-lobe", "label": "Right upper lobe" },
            { "id": "right-middle-lobe", "label": "Right middle lobe" },
            { "id": "right-lower-lobe", "label": "Right lower lobe" },
            { "id": "left-upper-lobe", "label": "Left upper lobe" },
            { "id": "left-lower-lobe", "label": "Left lower lobe" }
          ],
          "correctOptionId": "right-upper-lobe"
        },
        { "levelId": "segment", "input": "structure_choice", "parentLevelId": "lobe", "weight": 0.45, "targetStructureId": "right-upper-apical-segment" }
      ],
      "explanation": "Upper-airway orientation comes from the upward path and the apical or anterior branch direction."
    },
    "completion": { "mode": "answer" }
  },
  "feedback": {
    "correct": "The upward airway path and branch direction were the key clues.",
    "incorrect": "Use the upper-lobe path first, then compare the apical and anterior branch direction.",
    "answerTemplate": "Actual location: {answer}."
  },
  "difficulty": {
    "warmup": { "timeLimitSeconds": 80, "maxMoves": 5, "maxHopsFromEntry": 2, "orientationLabels": "patient" },
    "challenge": { "timeLimitSeconds": 80, "maxMoves": 4, "maxHopsFromEntry": 2, "orientationLabels": "patient" },
    "expert": { "timeLimitSeconds": 65, "maxMoves": 3, "maxHopsFromEntry": 1, "orientationLabels": "hidden" }
  }
}
