{
  "schemaVersion": "0.1",
  "roundVersion": "1",
  "id": "airway-drop-look",
  "title": "Where are you?",
  "mechanic": "spatial_look",
  "anatomyMapId": "respiratory-game-map",
  "intro": "Find the orange drop point on the airway map. Use patient left and right, height and branch depth to classify its location.",
  "timeLimitSeconds": 60,
  "drop": {
    "pools": {
      "warmup": ["trachea-mid", "carina", "right-main-airway", "left-main-airway"],
      "challenge": ["right-upper-airway", "right-middle-airway", "right-lower-airway", "left-upper-airway", "left-lower-airway"],
      "expert": ["right-upper-apical-airway", "right-lower-posterior-airway", "left-upper-apicoposterior-airway", "left-lower-posterior-airway"]
    }
  },
  "explore": {
    "id": "airway-drop-scene",
    "type": "anatomy_explore",
    "content": {
      "anatomyMapId": "respiratory-game-map",
      "prompt": "Find the orange drop point. Drag to rotate and use the bright airway map for context.",
      "startView": { "mode": "waypoint_marker", "waypointId": "trachea-mid" },
      "navigation": "orbit",
      "orientationLabels": "hidden"
    },
    "completion": { "mode": "viewed" }
  },
  "primitive": {
    "id": "airway-drop-answer",
    "type": "anatomy_locate",
    "content": {
      "anatomyMapId": "respiratory-game-map",
      "prompt": "Classify the orange drop point.",
      "answerFrom": "entry",
      "levels": [
        {
          "levelId": "side",
          "input": "choice",
          "weight": 0.4,
          "options": [
            { "id": "midline-airway", "label": "Midline" },
            { "id": "right-lung", "label": "Right" },
            { "id": "left-lung", "label": "Left" }
          ],
          "correctOptionId": "midline-airway"
        },
        {
          "levelId": "region",
          "input": "choice",
          "weight": 0.3,
          "options": [
            { "id": "region-central", "label": "Central" },
            { "id": "region-upper", "label": "Upper" },
            { "id": "region-middle", "label": "Middle" },
            { "id": "region-lower", "label": "Lower" }
          ],
          "correctOptionId": "region-central"
        },
        {
          "levelId": "airway-level",
          "input": "choice",
          "weight": 0.3,
          "options": [
            { "id": "trachea", "label": "Trachea" },
            { "id": "main-bronchus", "label": "Main bronchus" },
            { "id": "lobar-bronchus", "label": "Lobar bronchus" },
            { "id": "segmental-bronchus", "label": "Segmental bronchus" }
          ],
          "correctOptionId": "trachea"
        }
      ],
      "explanation": "The marker position and branch depth identify each dimension."
    },
    "completion": { "mode": "answer" }
  },
  "feedback": {
    "correct": "The drop point's side, height and distance from the trachea identify its location.",
    "incorrect": "Use patient left and right, then compare the drop point's height and branch depth.",
    "answerTemplate": "Correct answer: {answer}."
  },
  "difficulty": {
    "warmup": { "timeLimitSeconds": 65, "orientationLabels": "patient" },
    "challenge": { "timeLimitSeconds": 60, "orientationLabels": "patient" },
    "expert": { "timeLimitSeconds": 50, "orientationLabels": "hidden" }
  }
}
