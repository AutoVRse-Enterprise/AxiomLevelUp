        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "neutralLabel": {
            "type": "string",
            "minLength": 1
          },
          "answerIds": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "position": {
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "minItems": 3,
            "maxItems": 3
          },
          "lookAt": {
            "type": "array",
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "additionalItems": false,
            "minItems": 3,
            "maxItems": 3
          },
          "next": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "lumen": {
            "type": "object",
            "properties": {
              "ringCount": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              }
            },
            "required": [
              "ringCount"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label",
          "position",
          "lookAt",
          "next"
        ],
        "additionalProperties": false
      }
