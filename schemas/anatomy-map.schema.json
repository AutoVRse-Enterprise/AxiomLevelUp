{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "modelAssetId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "levels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "clueIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "structures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "levelId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "parentId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "clueIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              },
              "meshNames": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "levelId",
              "label",
              "meshNames"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "levelId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "parentId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "clueIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              },
              "volume": {
                "type": "object",
                "properties": {
                  "shape": {
                    "type": "string",
                    "const": "ellipsoid"
                  },
                  "center": {
                    "type": "array",
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "radii": {
                    "type": "array",
                    "items": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "rotation": {
                    "type": "array",
                    "items": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "shape",
                  "center",
                  "radii"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "levelId",
              "label",
              "volume"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "waypoints": {
      "minItems": 1,
      "type": "array",
