{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "conceptIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "content": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "assets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "completion": {
      "default": {
        "mode": "viewed"
      },
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "viewed"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "answer"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "minimum_interactions"
                },
                "count": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "mode",
                "count"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "explored"
                },
                "count": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "media_progress"
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "measurement"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "outcome"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "interacted"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "correct_order"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": {}
        }
      ]
    },
    "scoring": {
      "default": {
        "weight": 1
      },
      "type": "object",
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "foundation",
            "intermediate",
            "advanced"
          ]
        },
        "weight": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "weight"
      ],
      "additionalProperties": {}
    },
    "feedback": {
      "default": {},
      "type": "object",
      "properties": {
        "retry": {
          "type": "boolean"
        },
        "maxAttempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "correct": {
          "type": "string",
          "minLength": 1
        },
        "incorrect": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {}
    },
    "reward": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "badge",
            "certificate",
            "points",
            "recognition"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": [
            "string",
            "number"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "artifactRef": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "timer": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "default": "countdown",
          "type": "string",
          "enum": [
            "countdown",
            "elapsed"
          ]
        }
      },
      "required": [
        "durationSeconds",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "conceptIds",
    "content",
    "assets",
    "completion",
    "scoring",
    "feedback"
  ],
  "additionalProperties": false
}
