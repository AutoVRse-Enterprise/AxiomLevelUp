{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "conceptIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "content": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "assets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "completion": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "scoring": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "feedback": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "reward": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "badge",
            "certificate",
            "points",
            "recognition"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string"
        },
        "page": {
          "type": [
            "string",
            "number"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "artifactRef": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "timer": {
      "type": "object",
      "properties": {
        "durationSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "default": "countdown",
          "type": "string",
          "enum": [
            "countdown",
            "elapsed"
          ]
        }
      },
      "required": [
        "durationSeconds",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "type",
    "conceptIds",
    "content",
    "assets",
    "completion",
    "scoring",
    "feedback"
  ],
  "additionalProperties": false
}
