{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "appConfig": {
      "type": "string",
      "minLength": 1
    },
    "courses": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seeds": {
      "type": "object",
      "properties": {
        "advanced": {
          "type": "string",
          "minLength": 1
        },
        "fresh": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "advanced",
        "fresh"
      ],
      "additionalProperties": false
    },
    "defaultSeed": {
      "type": "string",
      "enum": [
        "advanced",
        "fresh"
      ]
    },
    "assetManifest": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "appConfig",
    "courses",
    "seeds",
    "defaultSeed",
    "assetManifest"
  ],
  "additionalProperties": false
}
