{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "dicom",
              "document",
              "text"
            ]
          },
          "offlineRequired": {
            "type": "boolean"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mimeType": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "series": {
            "type": "object",
            "properties": {
              "sliceCount": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rows": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "columns": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "pixelSpacingMm": {
                "type": "array",
                "items": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                ],
                "additionalItems": false,
                "minItems": 2,
                "maxItems": 2
              },
              "sliceThicknessMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "calibrated": {
                "type": "boolean"
              }
            },
            "required": [
              "sliceCount",
              "rows",
              "columns",
              "pixelSpacingMm",
              "sliceThicknessMm",
              "calibrated"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "assetId",
          "path",
          "type",
          "offlineRequired"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false
}
