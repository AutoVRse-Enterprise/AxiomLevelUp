{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio",
              "dicom",
              "document"
            ]
          },
          "offlineRequired": {
            "type": "boolean"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "assetId",
          "path",
          "type",
          "offlineRequired"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false
}
