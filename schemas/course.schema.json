{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "courseVersion": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "imageAssetId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "estimatedMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "foundation",
        "intermediate",
        "advanced"
      ]
    },
    "authors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conceptIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "completionRequirement": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "all_lessons",
            "minimum_lessons"
          ]
        },
        "minimumLessons": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "lessons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "estimatedMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "foundation",
              "intermediate",
              "advanced"
            ]
          },
          "conceptIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "xpReward": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "starThresholds": {
            "type": "object",
            "properties": {
              "one": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "two": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "three": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "one",
              "two",
              "three"
            ],
            "additionalProperties": false
          },
          "prerequisites": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "primitives": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "conceptIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  }
                },
                "content": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "assets": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  }
                },
                "completion": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "scoring": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "feedback": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "reward": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "badge",
                        "certificate",
                        "points",
                        "recognition"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "section": {
                      "type": "string"
                    },
                    "page": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "artifactRef": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                },
                "timer": {
                  "type": "object",
                  "properties": {
                    "durationSeconds": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "mode": {
                      "default": "countdown",
                      "type": "string",
                      "enum": [
                        "countdown",
                        "elapsed"
                      ]
                    }
                  },
                  "required": [
                    "durationSeconds",
                    "mode"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "type",
                "conceptIds",
                "content",
                "assets",
                "completion",
                "scoring",
                "feedback"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "estimatedMinutes",
          "difficulty",
          "conceptIds",
          "xpReward",
          "prerequisites",
          "primitives"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "courseVersion",
    "id",
    "title",
    "description",
    "category",
    "estimatedMinutes",
    "difficulty",
    "authors",
    "conceptIds",
    "prerequisites",
    "completionRequirement",
    "lessons"
  ],
  "additionalProperties": false
}
