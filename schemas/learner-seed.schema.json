{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "stateVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "seedProfile": {
      "type": "string",
      "enum": [
        "fresh",
        "advanced"
      ]
    },
    "referenceDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "learner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "avatar": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "xp": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "weekly": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "weekly"
      ],
      "additionalProperties": false
    },
    "streak": {
      "type": "object",
      "properties": {
        "currentDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lastQualifyingDate": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "currentDays",
        "lastQualifyingDate"
      ],
      "additionalProperties": false
    },
    "weeklyGoal": {
      "type": "object",
      "properties": {
        "targetDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "completedDays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "targetDays",
        "completedDays"
      ],
      "additionalProperties": false
    },
    "lessonProgress": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "current",
              "available",
              "locked",
              "new"
            ]
          },
          "stars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "bestScore": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lastPrimitiveIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "stars",
          "bestScore",
          "attempts",
          "lastPrimitiveIndex",
          "completedAt"
        ],
        "additionalProperties": false
      }
    },
    "challenges": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bestScore": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "completed",
          "progress",
          "bestScore"
        ],
        "additionalProperties": false
      }
    },
    "badges": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unlockedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "unlockedAt",
          "progress"
        ],
        "additionalProperties": false
      }
    },
    "mastery": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "delta": {
                  "type": "number"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "at",
                "delta",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "score",
          "history"
        ],
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "coursesCompleted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lessonsCompleted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "challengesCompleted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "questionsAnswered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "correctAnswers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "coursesCompleted",
        "lessonsCompleted",
        "challengesCompleted",
        "questionsAnswered",
        "correctAnswers"
      ],
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "viewed": {
          "type": "boolean"
        }
      },
      "required": [
        "viewed"
      ],
      "additionalProperties": false
    },
    "offlineDownloads": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "downloading",
              "available",
              "failed"
            ]
          },
          "downloadedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "status",
          "downloadedBytes",
          "totalBytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "stateVersion",
    "seedProfile",
    "referenceDate",
    "learner",
    "xp",
    "streak",
    "weeklyGoal",
    "lessonProgress",
    "challenges",
    "badges",
    "mastery",
    "stats",
    "onboarding",
    "offlineDownloads"
  ],
  "additionalProperties": false
}
