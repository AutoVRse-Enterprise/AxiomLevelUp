{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cohortName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "cohortName"
      ],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "weekStartsOn": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "revision": {
          "type": "object",
          "properties": {
            "masteryThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "maxRecommendations": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "masteryThreshold",
            "maxRecommendations"
          ],
          "additionalProperties": false
        },
        "leaderboard": {
          "type": "object",
          "properties": {
            "visibleWindow": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "visibleWindow"
          ],
          "additionalProperties": false
        },
        "home": {
          "type": "object",
          "properties": {
            "recentAchievementCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "recentAchievementCount"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "weekStartsOn",
        "revision",
        "leaderboard",
        "home"
      ],
      "additionalProperties": false
    },
    "gamification": {
      "type": "object",
      "properties": {
        "xp": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "levels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "minimumXp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "minimumXp"
            ],
            "additionalProperties": false
          }
        },
        "stars": {
          "type": "object",
          "properties": {
            "one": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "two": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "three": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "one",
            "two",
            "three"
          ],
          "additionalProperties": false
        },
        "mastery": {
          "type": "object",
          "properties": {
            "gain": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "loss": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "difficultyWeights": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "required": [
            "gain",
            "loss",
            "difficultyWeights"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "xp",
        "levels",
        "stars",
        "mastery"
      ],
      "additionalProperties": false
    },
    "concepts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "pathways": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "active": {
            "type": "boolean"
          },
          "nodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "lesson",
                    "assessment",
                    "case",
                    "challenge",
                    "practice",
                    "checkpoint"
                  ]
                },
                "refId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "optional": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "type",
                "refId",
                "optional"
              ],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "active",
          "nodes",
          "edges"
        ],
        "additionalProperties": false
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "learning",
              "performance",
              "consistency"
            ]
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "rewardXp": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "category",
          "icon",
          "rewardXp"
        ],
        "additionalProperties": false
      }
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "daily",
              "weekly"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "estimatedMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rewardXp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "itemCount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "items": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "conceptIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  }
                },
                "content": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "assets": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  }
                },
                "completion": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "scoring": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "feedback": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "reward": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "badge",
                        "certificate",
                        "points",
                        "recognition"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9][a-z0-9_-]*$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "section": {
                      "type": "string"
                    },
                    "page": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "artifactRef": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                },
                "timer": {
                  "type": "object",
                  "properties": {
                    "durationSeconds": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "mode": {
                      "default": "countdown",
                      "type": "string",
                      "enum": [
                        "countdown",
                        "elapsed"
                      ]
                    }
                  },
                  "required": [
                    "durationSeconds",
                    "mode"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "type",
                "conceptIds",
                "content",
                "assets",
                "completion",
                "scoring",
                "feedback"
              ],
              "additionalProperties": false
            }
          },
          "target": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "description",
          "estimatedMinutes",
          "rewardXp",
          "itemCount",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "leaderboard": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "const": "weekly"
        },
        "entries": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "weeklyXp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "isCurrentLearner": {
                "default": false,
                "type": "boolean"
              },
              "previousRank": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "weeklyXp",
              "isCurrentLearner"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scope",
        "period",
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "app",
    "product",
    "gamification",
    "concepts",
    "pathways",
    "badges",
    "challenges",
    "leaderboard"
  ],
  "additionalProperties": false
}
